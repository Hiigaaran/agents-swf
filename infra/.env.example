# Copia este archivo a .env y completa. .env NO se sube a git.

# --- RunPod -------------------------------------------------------------------
RUNPOD_API_KEY=
# Network volume (créalo una vez en la consola, ~100 GB, en un datacenter con la GPU
# que usarás). Guarda los pesos del modelo: no se re-descargan en cada pod.
NETWORK_VOLUME_ID=
POD_NAME=fabrica-gpu

# --- Seguridad ----------------------------------------------------------------
# Clave que exige vLLM. Genera una: openssl rand -hex 24
VLLM_API_KEY=
# Clave del gateway (la usan los agentes). openssl rand -hex 24
LITELLM_MASTER_KEY=sk-

# --- Túnel ----------------------------------------------------------------------
# tailscale (recomendado) | public (solo pruebas rápidas)
TUNNEL_MODE=tailscale
# Auth key efímera y reutilizable de https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=
TS_HOSTNAME=fabrica-gpu

# --- Modelos --------------------------------------------------------------------
HF_TOKEN=
# Fija una versión ≥ 0.19 cuando la valides (p. ej. vllm/vllm-openai:v0.XX.Y)
# y usa EXACTAMENTE la misma en local.
VLLM_IMAGE=vllm/vllm-openai:latest
CONTAINER_DISK_GB=40
