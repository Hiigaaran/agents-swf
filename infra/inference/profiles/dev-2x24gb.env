# -----------------------------------------------------------------------------
# Perfil DEV-2x24GB — simula 2× RTX 3090: un modelo por GPU.
#   GPU 0 → razonamiento (Requerimientos, Arquitecto, Líder)
#   GPU 1 → código       (Desarrollador, QA)
# Repos AWQ de la comunidad: verifícalos antes de usar.
# -----------------------------------------------------------------------------
PROFILE_NAME=dev-2x24gb
GPU_TYPE_IDS="NVIDIA GeForce RTX 4090,NVIDIA GeForce RTX 3090"
GPU_COUNT=2
CLOUD_TYPE=SECURE

MODEL_A=cyankiwi/Qwen3.6-35B-A3B-AWQ-4bit
NAMES_A="razonamiento"
MAX_LEN_A=32768
GPUS_A=0
PORT_A=8000
EXTRA_ARGS_A="--reasoning-parser qwen3 --tool-call-parser qwen3_coder --language-model-only"

MODEL_B=QuantTrio/Qwen3-Coder-30B-A3B-Instruct-AWQ
NAMES_B="codigo"
MAX_LEN_B=32768
GPUS_B=1
PORT_B=8001
EXTRA_ARGS_B="--tool-call-parser qwen3_coder"

ROUTE_RAZONAMIENTO=A
ROUTE_CODIGO=B
