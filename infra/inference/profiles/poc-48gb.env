# -----------------------------------------------------------------------------
# Perfil POC-48GB — punto de partida recomendado.
# 1 GPU de 48 GB (L40S / RTX A6000 / A40). Un solo modelo para todos los roles,
# pesos FP8 oficiales de Qwen: es la combinación con menos sorpresas.
# -----------------------------------------------------------------------------
PROFILE_NAME=poc-48gb
GPU_TYPE_IDS="NVIDIA L40S,NVIDIA RTX A6000,NVIDIA A40"   # orden = prioridad
GPU_COUNT=1
CLOUD_TYPE=SECURE            # SECURE recomendado: tu código pasa por esta máquina

MODEL_A=Qwen/Qwen3.6-35B-A3B-FP8
NAMES_A="razonamiento codigo"   # ambos nombres lógicos los atiende el mismo modelo
MAX_LEN_A=65536
GPUS_A=0
PORT_A=8000
# --language-model-only omite el encoder de visión y libera VRAM para KV cache
EXTRA_ARGS_A="--reasoning-parser qwen3 --tool-call-parser qwen3_coder --language-model-only"

# A qué instancia apunta cada nombre lógico del gateway (A o B)
ROUTE_RAZONAMIENTO=A
ROUTE_CODIGO=A
