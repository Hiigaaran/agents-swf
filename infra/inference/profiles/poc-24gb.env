# -----------------------------------------------------------------------------
# Perfil POC-24GB — simula la GPU que comprarías (RTX 3090/4090).
# Úsalo DESPUÉS de que poc-48gb funcione, para medir si 24 GB te alcanzan.
# Requiere pesos 4-bit (AWQ). OJO: el repo AWQ es de la comunidad; verifica en
# Hugging Face que exista y que sea compatible con tu versión de vLLM.
# -----------------------------------------------------------------------------
PROFILE_NAME=poc-24gb
GPU_TYPE_IDS="NVIDIA GeForce RTX 4090,NVIDIA GeForce RTX 3090"
GPU_COUNT=1
CLOUD_TYPE=SECURE

MODEL_A=cyankiwi/Qwen3.6-35B-A3B-AWQ-4bit
NAMES_A="razonamiento codigo"
MAX_LEN_A=32768              # 24 GB: no subir de 32K–64K o habrá OOM
GPUS_A=0
PORT_A=8000
EXTRA_ARGS_A="--reasoning-parser qwen3 --tool-call-parser qwen3_coder --language-model-only"

ROUTE_RAZONAMIENTO=A
ROUTE_CODIGO=A
